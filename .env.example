ATMOCE_BASE_URL=https://www.atmocecloud.com
ATMOCE_APP_KEY=your-atmoce-openapi-app-key
ATMOCE_APP_SECRET=your-atmoce-openapi-app-secret
ATMOCE_USERNAME=your-atmoce-username
ATMOCE_PASSWORD=your-atmoce-password

HUAWEI_BASE_URL=https://kr5.fusionsolar.huawei.com
HUAWEI_USERNAME=your-huawei-northbound-username
HUAWEI_SYSTEM_CODE=your-huawei-northbound-system-code

# Optional Huawei01 Northbound API account. HUAWEI01_PASSWORD is treated as
# the Huawei Northbound systemCode when HUAWEI01_SYSTEM_CODE is not set.
HUAWEI01_BASE_URL=https://kr5.fusionsolar.huawei.com
HUAWEI01_USERNAME=your-huawei01-northbound-username
HUAWEI01_PASSWORD=your-huawei01-northbound-system-code-or-password

# Optional Huawei01 web snapshot fallback. Defaults to this path when present
# and Huawei01 API credentials are not configured.
HUAWEI01_JSON_PATH=data/huawei01_sites.json
