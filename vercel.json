{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/",
      "destination": "/static/index.html"
    },
    {
      "source": "/api/export.csv",
      "destination": "/api/export"
    },
    {
      "source": "/api/report.csv",
      "destination": "/api/report"
    },
    {
      "source": "/api/report.html",
      "destination": "/api/report_html"
    },
    {
      "source": "/api/monthly-kwh",
      "destination": "/api/monthly_kwh"
    }
  ]
}
